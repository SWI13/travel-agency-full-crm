# ─────────────────────────────────────────────────────────────────────────────
# Umrah & Hajj Agency CRM — environment variables
#
# Copy this file to `.env` and fill in what you have. Every value is read on the
# SERVER only. Nothing here is ever sent to the browser, except the single
# variable that starts with VITE_.
#
# With everything left empty the app still runs: it uses a local demo datastore
# and shows WhatsApp as "Not connected".
# ─────────────────────────────────────────────────────────────────────────────

# ── First administrator ─────────────────────────────────────────────────────
# Created automatically on first start, only while no employee exists.
# If left empty, the sign-in page offers a one-time "Create the first administrator" form.
ADMIN_EMAIL=
ADMIN_PASSWORD=            # at least 10 characters
ADMIN_NAME=Administrator

# ── Sessions ────────────────────────────────────────────────────────────────
# Signs the session cookie. REQUIRED in production: 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (In development a random secret is generated and stored in .data/session-secret.)
SESSION_SECRET=

# Public address of the deployed app, without a trailing slash (e.g. https://crm.agence.dz).
# Used to display the webhook URL to paste into Meta.
PUBLIC_BASE_URL=

# ── Database: Appwrite ──────────────────────────────────────────────────────
# Leave all three empty to use the local demo datastore (.data/db.json).
# Fill all three to store data in Appwrite; tables are created automatically on first start.
APPWRITE_ENDPOINT=         # e.g. https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=          # server API key (scopes: databases/tables/rows read+write, users read+write)
APPWRITE_DATABASE_ID=umrah_crm

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# See docs/META_SETUP.md. The first two are enough to RECEIVE messages.
WHATSAPP_VERIFY_TOKEN=     # any random text you choose; paste the same value in Meta's webhook form
WHATSAPP_APP_SECRET=       # Meta app → App settings → Basic → App secret (verifies webhook signatures)
# These three enable the "Test connection" button and connection details.
WHATSAPP_ACCESS_TOKEN=     # permanent system-user token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v27.0

# ── Demo tools ──────────────────────────────────────────────────────────────
# Simulated webhook events and sample data. Default: on in development, OFF in production.
# Set to true on a staging server if you want to demonstrate the product there.
DEMO_TOOLS=

# Folder of the local demo datastore (only used when Appwrite is not configured).
DATA_DIR=.data

# ── Optional: Syncfusion charts ─────────────────────────────────────────────
# With a licence key (free community licence available) the analytics chart uses Syncfusion.
# Without it a built-in chart is used, so no trial banner is ever shown.
VITE_SYNCFUSION_LICENSE_KEY=
